{
  "name": "jev-fabric",
  "version": "0.2.0",
  "private": true,
  "description": "Native process orchestration with typed, explicit Jev decisions, written in Bend.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "jev-fabric": "build/jev-fabric",
    "jev-fabric-reference": "dist/src/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "files": [
    "LICENSE",
    "README.md",
    "dist/src",
    "docs",
    "examples",
    "install.sh",
    "native",
    "scripts",
    "skills",
    "static"
  ],
  "scripts": {
    "build": "sh scripts/build-native.sh",
    "build:reference": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:native": "sh scripts/build-native.sh",
    "test:native": "sh scripts/test-native.sh",
    "check:native-safety": "bun scripts/check-native-safety.ts",
    "test:reference": "bun run build:reference && node --test dist/tests/*.test.js",
    "test": "bun run test:native && bun run test:reference",
    "demo": "sh scripts/build-native.sh && build/jev-fabric -- run examples/native/pipeline.bend",
    "demo:reference": "node dist/src/cli.js run examples/pipeline.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^6.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/monotykamary/jev-fabric.git"
  },
  "homepage": "https://github.com/monotykamary/jev-fabric"
}
